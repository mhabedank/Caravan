{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhabedank/Caravan/specs/011-site-imagery/contracts/image-record.schema.json",
  "title": "Placed image record",
  "description": "docs/_static/images/<id>/image.yaml \u2014 a picked image brought into the repository. Adapted from the Mobility Model Zoo's feature 016 record (copied 2026-10-27), with every field that only fed the zoo's triage, pool or coverage machinery removed per FR-007. The two may drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "series",
    "theme",
    "subject",
    "generation",
    "licence",
    "placements",
    "scene",
    "alt",
    "focal_point",
    "aspect",
    "source",
    "derivatives"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique across the site; names the directory and the derivative files."
    },
    "series": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A free string, not a closed enum: the zoo's enum fed its coverage check, which is not ported (FR-007)."
    },
    "subject": {
      "type": "string"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "description": "The recipe, copied verbatim from the round's manifest entry. This is FR-018 surviving placement (FR-020).",
      "required": [
        "model",
        "revision",
        "model_licence",
        "model_card",
        "pipeline",
        "prompt",
        "negative_prompt",
        "seed",
        "steps",
        "guidance",
        "width",
        "height",
        "generated",
        "hardware",
        "generator"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "model_licence": {
          "type": "string"
        },
        "model_card": {
          "type": "string",
          "format": "uri"
        },
        "pipeline": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "The complete prompt as sent, style sentence included."
        },
        "negative_prompt": {
          "type": "string",
          "description": "Empty where the model takes none, as the draft model does (R8)."
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "guidance": {
          "type": "number"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "generated": {
          "type": "string",
          "format": "date"
        },
        "hardware": {
          "type": "string",
          "description": "The class of machine, not its name: the image is only reproducible on the same hardware."
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "image_digest"
          ],
          "properties": {
            "commit": {
              "type": "string"
            },
            "image_digest": {
              "type": "string"
            },
            "script_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Required for an image this repository rendered. An image imported from the zoo carries what the zoo recorded, which has no script hash; its `origin` says where that record is."
            }
          }
        }
      }
    },
    "licence": {
      "const": "CC0-1.0",
      "description": "The image's own licence (FR-030). The model's licence is generation.model_licence."
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The pages this image appears on. Never empty: Caravan has no pool, so an unplaced record has no reason to exist (FR-007)."
    },
    "scene": {
      "type": "string",
      "minLength": 1,
      "description": "One line, for the credits page."
    },
    "alt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\(AI-generated image\\)$",
      "description": "The text alternative, ending in the disclosure suffix (FR-028)."
    },
    "focal_point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "aspect": {
      "enum": [
        "16:9",
        "3:2"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "sha256"
      ],
      "description": "The render the derivatives were cut from. The PNG itself is not committed.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "derivatives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "480",
        "960",
        "1600"
      ],
      "description": "The three widths the pages use (FR-027). Their bytes together must stay within 118000 (research R2).",
      "patternProperties": {
        "^(480|960|1600)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "bytes",
            "sha256"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "\\.webp$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "record",
        "copied"
      ],
      "description": "Present only on an image placed from another project's finished set (FR-003). Names where the image and its record come from.",
      "properties": {
        "project": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "copied": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
